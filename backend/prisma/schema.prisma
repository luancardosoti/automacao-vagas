datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Template {
  id        String   @id @default(cuid())
  nome      String
  texto     String // use [nome] onde o nome da pessoa deve entrar
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  envios    Envio[]
  etapas    FluxoEtapa[]
}

model Contato {
  id           String   @id @default(cuid())
  nome         String // nome de identificação, ex: "Maria - recrutadora XPTO"
  nomeMensagem String? // nome usado no lugar de [nome] na mensagem; se vazio, usa `nome`
  telefone     String // ex: 55DDDNUMERO, apenas dígitos
  createdAt    DateTime @default(now())
  envios       Envio[]
  disparos     Disparo[]
}

model Envio {
  id         String   @id @default(cuid())
  templateId String
  contatoId  String
  mensagem   String
  status     String // enviado | falhou
  erro       String?
  createdAt  DateTime @default(now())

  template Template @relation(fields: [templateId], references: [id])
  contato  Contato  @relation(fields: [contatoId], references: [id])
}

model Documento {
  id           String   @id @default(cuid())
  nome         String // nome de exibição, ex: "Currículo - Luan"
  nomeArquivo  String // nome do arquivo salvo em disco (uploads/)
  nomeOriginal String // nome original enviado no upload
  mimetype     String
  tamanho      Int
  createdAt    DateTime @default(now())

  etapas FluxoEtapa[]
}

// Um fluxo é uma sequência de etapas (template, documento ou texto livre)
// disparada em ordem para um contato, ex: mensagem de apresentação + currículo.
model Fluxo {
  id        String   @id @default(cuid())
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  etapas   FluxoEtapa[]
  disparos Disparo[]
}

model FluxoEtapa {
  id          String  @id @default(cuid())
  fluxoId     String
  ordem       Int
  tipo        String // template | documento | texto
  templateId  String?
  documentoId String?
  texto       String? // usado quando tipo = texto (aceita [nome])

  fluxo     Fluxo      @relation(fields: [fluxoId], references: [id], onDelete: Cascade)
  template  Template?  @relation(fields: [templateId], references: [id])
  documento Documento? @relation(fields: [documentoId], references: [id])
}

// Registro de um disparo de fluxo para um contato, com o resultado de cada etapa.
model Disparo {
  id        String   @id @default(cuid())
  fluxoId   String
  contatoId String
  status    String // enviado | parcial | falhou
  detalhes  String // JSON com o resultado de cada etapa
  createdAt DateTime @default(now())

  fluxo   Fluxo   @relation(fields: [fluxoId], references: [id])
  contato Contato @relation(fields: [contatoId], references: [id])
}
