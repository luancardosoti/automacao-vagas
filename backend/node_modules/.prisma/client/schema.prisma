datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Template {
  id        String   @id @default(cuid())
  nome      String
  texto     String // use [nome] onde o nome da pessoa deve entrar
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  envios    Envio[]
}

model Contato {
  id        String   @id @default(cuid())
  nome      String
  telefone  String // ex: 55DDDNUMERO, apenas dígitos
  createdAt DateTime @default(now())
  envios    Envio[]
}

model Envio {
  id         String   @id @default(cuid())
  templateId String
  contatoId  String
  mensagem   String
  status     String // enviado | falhou
  erro       String?
  createdAt  DateTime @default(now())

  template Template @relation(fields: [templateId], references: [id])
  contato  Contato  @relation(fields: [contatoId], references: [id])
}
